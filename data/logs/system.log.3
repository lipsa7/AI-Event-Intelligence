opic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "The European Union has required them since August 2025, and since 2 August this year the Commission has been able to fine a model provider 3% of worldwide turnover. Article 55 of the AI Act has obliged providers of general-purpose models with systemic risk to run adversarial testing, assess risk at union level and report serious incidents without undue delay since August 2025. The penalties arrived in August. Since the second of that month the Commission has been able to fine a provider up to 3% of worldwide annual turnover or EUR 15M, whichever is higher. It can demand access to a model, order evaluations and require a provider to restrict its public availability.", "raw_actor_fields": {"acting_entity": null, "actor": null, "company": null, "institution": null, "organisation": null, "organization": null, "primary_actor": null, "regulator": null}, "raw_entity_mentions": [{"entity_type": "organization", "mention": "Commission", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "actor"}, {"entity_type": "unknown", "mention": "model provider", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "object"}], "resolved_primary_actor": "Commission", "source_id": "SOURCE-522409DCAF21B3E9CFDA38B3"}, {"admission_reasons": [], "admission_status": "considered", "diagnostic_version": "strategic-actor-admission-diagnostics-v1", "entity_mentions_state": "present", "event_id": "EVENT-10C50C86C45147D42A02257E", "event_keys": ["claim_status", "created_at", "entity_mentions", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_text", "event_type", "extraction_metadata", "published_at", "quantitative_claims", "relationship_mentions", "s