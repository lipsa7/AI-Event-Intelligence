"unknown", "role": "object", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"]}], "event_keys": ["claim_status", "created_at", "entity_mentions", "event_date_precision", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_resolved", "event_time_text", "event_type", "extraction_metadata", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "(In 2024, OpenAI established rules for how models should refuse: Always apologize, and don't be judgy.)"}, {"diagnostic_version": "strategic-actor-admission-diagnostics-v1", "event_id": "EVENT-6ED957DCBEBF48C1CED41520", "source_id": "SOURCE-68E783C62BEACFA9BF64436C", "admission_status": "considered", "admission_reasons": [], "resolved_primary_actor": "OpenAI", "entity_mentions_state": "present", "raw_actor_fields": {"primary_actor": null, "acting_entity": null, "actor": null, "organization": null, "organisation": null, "company": null, "institution": null, "regulator": null}, "raw_entity_mentions": [{"mention": "OpenAI", "entity_type": "organization", "role": "actor", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"]}, {"mention": "red-teamers", "entity_type": "unknown", "role": "object", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"]}], "event_keys": ["claim_status", "created_at", "entity_mentions", "event_date_precision", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_resolved", "event_time_text", "event_type", "extraction_metadata", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "Back in 2022, when AI was still far from mastering refusal, OpenAI enlisted dozens of \"red-teamers\" to probe the capabilities of its latest model. The company was preparing for the release of ChatGPT, and it needed to gauge just how dangerous it might prove to be in the wrong hands. The red-teamers were given minimal directions, Röttger told me. Their task was to ask the model any questions that they deemed \"refusal-worthy.\" Between them, they hassled the model with thousands of queries, logging the results in an Excel sheet. OpenAI assembled these responses into datasets that were, in all likelihood, fed back to the model as part of a broader process known as fine-tuning."}, {"diagnostic_version": "strategic-actor-admission-diagnostics-v1", "event_id": "EVENT-719BA2AC4874AF820278FDF9", "source_id": "SOURCE-68E783C62BEACFA9BF64436C", "admission_status": "considered", "admission_reasons": [], "resolved_primary_actor": "Anthropic", "entity_mentions_state": "present", "raw_actor_fields": {"primary_actor": null, "acting_entity": null, "actor": null, "organization": null, "organisation": null, "company": null, "institution": null, "regulator": null}, "raw_entity_mentions": [{"mention": "Anthropic", "entity_type": "organization", "role": "actor", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"]}, {"mention": "chatbots' compute costs", "entity_type": "unknown", "role": "object", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"]}], "event_keys": ["claim_status", "created_at", "entity_mentions", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_text", "event_type", "extraction_metadata", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "Earlier this year, Anthropic said that one type of classifier added 24% to its chatbots' compute costs."}, {"diagnostic_version": "strategic-actor-admission-diagnostics-v1", "event_id": "EVENT-90343D33355D1DD728623AC9", "source_id": "SOURCE-68E783C62BEACFA9BF64436C", "admission_status": "considered", "admission_reasons": [], "resolved_primary_actor": "Anthropic", "entity_mentions_state": "present", "raw_actor_fields": {"primary_actor": null, "acti