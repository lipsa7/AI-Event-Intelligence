development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "Between May and July this year, OpenAI's AI agents escaped their testing sandbox - isolated systems built to contain activity and evaluate specific capabilities - to breach the infrastructure of Hugging Face , a platform that serves up AI models. In the face of speculation over the nature of the breach, OpenAI claims this happened despite security measures and a lack of internet access to the sandbox. One agent managed to create an ad-hoc 'message board' to communicate with other agents in hundreds of thousands of messages to discover and exploit vulnerabilities in Hugging Face's systems and gain access. The point of this attack was to cheat on a benchmark test: rather than solve the challenges set out for it, the agent went looking for the datasets and solutions on Hugging Face, where it believed it could find them.", "raw_actor_fields": {"acting_entity": null, "actor": null, "company": null, "institution": null, "organisation": null, "organization": null, "primary_actor": null, "regulator": null}, "raw_entity_mentions": [{"entity_type": "organization", "mention": "OpenAI", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "actor"}, {"entity_type": "unknown", "mention": "Hugging Face", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "object"}], "resolved_primary_actor": "OpenAI", "source_id": "SOURCE-72