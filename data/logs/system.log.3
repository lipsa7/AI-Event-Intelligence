ster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "OpenAI fires workers for 'mishandling sensitive information' OpenAI fires workers for 'mishandling sensitive information' 3 days ago OpenAI has fired three researchers for allegedly mishandling information, including work which involved an external organisation analysing AI models. \"Our investigation confirmed that these individuals mishandled sensitive information outside established company procedures, violating our policies and breaking the trust essential to our work,\" a spokesperson told the BBC. \"We have parted ways with three individuals for violating our policies on accessing and handling sensitive company information,\" a spokesperson for OpenAI said.", "raw_actor_fields": {"acting_entity": null, "actor": null, "company": null, "institution": null, "organisation": null, "organization": null, "primary_actor": null, "regulator": null}, "raw_entity_mentions": [{"entity_type": "organization", "mention": "OpenAI", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "actor"}, {"entity_type": "unknown", "mention": "three researchers", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "object"}], "resolved_primary_actor": "OpenAI", "source_id": "SOURCE-B27664E370409D93C935C9AB"}, {"admission_reasons": [], "admission_status": "considered", "diagnostic_version": "strategic-actor-admission-diagnostics-v1", "entity_mentions_state": "present", "event_id": "EVENT-77000E8890CECBFF4D54F80A", "event_keys": ["actor_rec