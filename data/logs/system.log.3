, "updated_at"], "event_summary": "OpenAI fires workers for 'mishandling sensitive information' OpenAI fires workers for 'mishandling sensitive information' 3 days ago OpenAI has fired three researchers for allegedly mishandling information, including work which involved an external organisation analysing AI models. \"Our investigation confirmed that these individuals mishandled sensitive information outside established company procedures, violating our policies and breaking the trust essential to our work,\" a spokesperson told the BBC. \"We have parted ways with three individuals for violating our policies on accessing and handling sensitive company information,\" a spokesperson for OpenAI said."}, {"diagnostic_version": "strategic-actor-admission-diagnostics-v1", "event_id": "EVENT-77000E8890CECBFF4D54F80A", "source_id": "SOURCE-F2713022315255015DAEF71D", "admission_status": "considered", "admission_reasons": [], "resolved_primary_actor": "Donald Trump", "entity_mentions_state": "present", "raw_actor_fields": {"primary_actor": "Donald Trump", "acting_entity": null, "actor": null, "organization": null, "organisation": null, "company": null, "institution": null, "regulator": null}, "raw_entity_mentions": [{"mention": "Trump", "entity_type": "person", "role": "actor", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"]}, {"mention": "accord", "entity_type": "unknown", "role": "object", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"]}], "event_keys": ["actor_recovered_from", "claim_status", "created_at", "entity_mentions", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_text", "event_type", "extraction_metadata", "primary_actor", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_developm