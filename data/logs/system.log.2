, "event_id", "event_start_at", "event_time_resolved", "event_time_text", "event_type", "extraction_metadata", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "Despite the breach happening in June, Albanese said the tech giant only notified the government about the incident earlier this month and did so via an email to a generic \"public mailbox.\"", "raw_actor_fields": {"acting_entity": null, "actor": null, "company": null, "institution": null, "organisation": null, "organization": null, "primary_actor": null, "regulator": null}, "raw_entity_mentions": [{"entity_type": "organization", "mention": "OpenAI", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "actor"}, {"entity_type": "unknown", "mention": "government", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "object"}], "resolved_primary_actor": "OpenAI", "source_id": "SOURCE-50419A862D1E9782B95B8F0E"}, {"admission_reasons": [], "admission_status": "considered", "diagnostic_version": "strategic-actor-admission-diagnostics-v1", "entity_mentions_state": "present", "event_id": "EVENT-D7B2440E579DFBD39D35E5DE", "event_keys": ["claim_status", "created_at", "entity_mentions", "event_date_precision", "event_date