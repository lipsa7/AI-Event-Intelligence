pe_source"], "role": "actor"}, {"entity_type": "unknown", "mention": "three researchers", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "object"}], "resolved_primary_actor": "OpenAI", "source_id": "SOURCE-B27664E370409D93C935C9AB"}, {"admission_reasons": [], "admission_status": "considered", "diagnostic_version": "strategic-actor-admission-diagnostics-v1", "entity_mentions_state": "present", "event_id": "EVENT-77000E8890CECBFF4D54F80A", "event_keys": ["actor_recovered_from", "claim_status", "created_at", "entity_mentions", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_text", "event_type", "extraction_metadata", "primary_actor", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "Trump posted a copy of the accord to his Truth Social account with a one-page document that called for each participating company to implement four different measures to safeguard the technology and added that, later on, \"it might make sense to codify these steps into laws or regulations.\"", "raw_actor_fields": {"acting_entity": null, "actor": null, "company": null, "institution": null, "organisation": null, "organization": null, "primary_actor": "Donald Trump", "regulator": null}, "raw_entity_mentions": [{"ent