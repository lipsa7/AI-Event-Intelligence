trategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "President Trump gathered top artificial intelligence leaders in Washington on Tuesday and doubled down on his opposition to government intervention, suggesting that \"self-regulation\" is the answer to growing worries about the technology getting out of human control. \"There's a belief that there should be tremendous self-regulation,\" the president said after meeting with the assembled CEOs. Trump said he and the CEOs signed a \"morally binding\" accord that would keep the companies in line through \"self-policing and group policing.\" President Trump speaks with Nvidia CEO Jensen Huang and others during a meeting with technology executives about artificial intelligence in the East Room of the White House on Sept. 29. The \"meeting and luncheon on Super Intelligence,\" as the White House described the event, took place in the East Room, with Trump even posting the seating chart . President Donald Trump holds a press briefing with AI executives following a meeting on artificial intelligence at the White House on September 29.", "raw_actor_fields": {"acting_entity": null, "actor": null, "company": null, "institution": null, "organisation": null, "organization": null, "primary_actor": "Donald Trump", "regulator": null}, "raw_entity_mentions": [{"entity_type": "person", "mention": "Trump", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_