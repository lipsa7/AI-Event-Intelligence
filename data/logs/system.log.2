remely friendly.\"", "raw_actor_fields": {"acting_entity": null, "actor": null, "company": null, "institution": null, "organisation": null, "organization": null, "primary_actor": null, "regulator": null}, "raw_entity_mentions": [{"entity_type": "person", "mention": "Trump", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "actor"}, {"entity_type": "unknown", "mention": "tech CEOs and government officials", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "object"}], "resolved_primary_actor": "tech CEOs and government officials", "source_id": "SOURCE-C17896B7BB016684E2B7610E"}, {"admission_reasons": [], "admission_status": "considered", "diagnostic_version": "strategic-actor-admission-diagnostics-v1", "entity_mentions_state": "present", "event_id": "EVENT-7342AB2BEFB0DF6B3D041DCF", "event_keys": ["claim_status", "created_at", "entity_mentions", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_text", "event_type", "extraction_metadata", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "Trump orders US government to call AI ‘Super Intelligence’ Trump orders US government to call AI 'Super Intelligence' Going forward, official policy