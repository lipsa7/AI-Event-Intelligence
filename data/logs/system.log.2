nt", "event_id": "EVENT-62D5E5B338D312A58C3F0905", "event_keys": ["claim_status", "created_at", "entity_mentions", "event_date_precision", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_resolved", "event_time_text", "event_type", "extraction_metadata", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "MELBOURNE, Australia - Prime Minister Anthony Albanese said Thursday he was extremely concerned about OpenAI 's breach of an Australian health department website that the artificial intelligence company took too long to reveal. Anthropic and OpenAI CEOs call for AI development to slow down, OpenAI to delay IPO An OpenAI agent infiltrated the public-facing Medicare Statistics Reporting Service portal on July 18, he said. OpenAI said in a statement it had reviewed activity involving several Australian government departments and discovered \"our models took actions we did not intend.\" Government Services Minister Katy Gallagher said OpenAI had advised on Sept. 10 that an \"AI agent had accessed infrastructure behind the public-facing\" portal. Deputy Prime Minister Richard Marles said the incident was the first time that an AI agent was known to have gained unauthorized access to the Australian government's information technology systems. When the agent was denied information, it engaged is \"misaligned behavior\" to gain unauthorized access, he said.", "raw_actor_fields": {"acting_entity": null, "actor": null, "company": null, "institution": null, "organisation": null, "organization": null, "primary_actor": null, "regulator": null}, "raw_entity_mentions": [{"entity_type": "organization", "mention": "OpenAI", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "actor"}, {"entity_type": "unknown", "mention": "Medicare Statistics Reporting Service portal", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "object"}], "resolved_primary_actor": "OpenAI", "source_id": "SOURCE-58036158F50E552381CC7C82"}, {"admission_reasons": [], "admission_status": "considered", "diagnostic_version": "strategic-actor-admission-diagnostics-v1", "entity_mentions_state": "present", "event_id": "EVENT-7256626D1BC9109CEA597CEF", "event_keys": ["actor_recovered_from", "claim_status", "created_at", "entity_mentions", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_text", "event_type", "extraction_metadata", "primary_actor", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "She said the portal had been closed and