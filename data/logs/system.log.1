event_id", "underlying_event_member_count", "updated_at"], "event_summary": "President Trump gathered top artificial intelligence leaders in Washington on Tuesday and doubled down on his opposition to government intervention, suggesting that \"self-regulation\" is the answer to growing worries about the technology getting out of human control. \"There's a belief that there should be tremendous self-regulation,\" the president said after meeting with the assembled CEOs. Trump said he and the CEOs signed a \"morally binding\" accord that would keep the companies in line through \"self-policing and group policing.\" President Trump speaks with Nvidia CEO Jensen Huang and others during a meeting with technology executives about artificial intelligence in the East Room of the White House on Sept. 29. The \"meeting and luncheon on Super Intelligence,\" as the White House described the event, took place in the East Room, with Trump even posting the seating chart . President Donald Trump holds a press briefing with AI executives following a meeting on artificial intelligence at the White House on September 29."}, {"diagnostic_version": "strategic-actor-admission-diagnostics-v1", "event_id": "EVENT-BAEEEC1D65A033D1EB45D8C6", "source_id": "SOURCE-2B7353670B018A3630DE0F0F", "admission_status": "considered", "admission_reasons": [], "resolved_primary_actor": "Donald Trump", "entity_mentions_state": "present", "raw_actor_fields": {"primary_actor": "Donald Trump", "acting_entity": null, "actor": null, "organization": null, "organisation": null, "company": null, "institution": null, "regulator": null}, "raw_entity_mentions": [{"mention": "Trump", "entity_type": "person", "role": "actor", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"]}, {"mention": "UN General Assembly", "entity_type": "unknown", "role": "object", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"]}], "event_k