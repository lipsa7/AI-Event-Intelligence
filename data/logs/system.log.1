y_type", "mention", "role", "sentence_id", "source_span", "type_source"]}], "event_keys": ["actor_recovered_from", "claim_status", "created_at", "entity_mentions", "event_date_precision", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_resolved", "event_time_text", "event_type", "extraction_metadata", "primary_actor", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "Albanese made the breach public following a telephone conversation with OpenAI chief executive Sam Altman. \"Today I spoke with ... Altman to express Australia's extreme concern about this incident,\" Albanese told reporters. \"I also expressed my disappointment that it took the company way too long to inform the government what had occurred and the nature of the way that notification occurred as well was unacceptable.\""}, {"diagnostic_version": "strategic-actor-admission-diagnostics-v1", "event_id": "EVENT-F26FB7427E1B51498FC521A7", "source_id": "SOURCE-62E4F84D0677B1E6F242A961", "admission_status": "considered", "admission_reasons": [], "resolved_primary_actor": "Juspay", "entity_mentions_state": "present", "raw_actor_fields": {"primary_actor": null, "acting_entity": null, "actor": null, "organization": null, "organisation": null, "company": null, "institution": null, "regulator": null}, "raw_entity_mentions": [{"mention": "Juspay", "entity_type": "organization", "role": "actor", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"]}], "event_keys": ["claim_status", "created_at", "entity_mentions", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_text", "event_type", "extraction_metadata", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "Juspay FY26 revenue rises 30% to Rs 664 Cr as international business and AI bets scale Juspay FY26 revenue rises 30% to Rs 664 Cr as international business and AI bets scale Juspay reported a 30% year-on-year increase in FY26 revenue to Rs 664 crore, driven by global expansion and scaling daily transaction volumes, while strategic investments in AI infrastructure widened its net loss. Global payments technology company Juspay reported a 30% year-on-year increase in revenue for the financial year ended March 31, 2026 (FY26), reaching Rs 664 crore, up from Rs 514 crore in FY25. The Bengaluru-headquartered fintech firm remained Adjusted EBITDA positive at Rs 33 crore for FY26, excluding non-cash ESOP costs. However, increased capital allocation towards global market expansion and deep-tech artificial intelligence infrastructure widened its net loss to Rs 90 crore for the fiscal year."}, {"diagnostic_version": "strategic-actor-admission-diagnostics-v1", "event_id": "EVENT-049116C4444C8538C4F14DBE", "source_id": "SOURCE-68E783C62BEACFA9BF64436C", "admission_status": "considered", "admission_reasons": [], "resolved_primary_actor": "OpenAI", "entity_mentions_state": "present", "raw_actor_fields": {"primary_actor": null, "acting_entity": null, "actor": null, "organization": null, "organisation": null, "company": null, "institution": null, "regulator": null}, "raw_entity_mentions": [{"mention": "OpenAI", "entity_type": "organization", "role": "actor", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"]}, {"mention": "OpenAI for Countries", "entity_type": "unknown", "role": "object", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"]}], "event_keys": ["claim_status", "created_at", "entity_mentions", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_text", "event_type", "extraction_metadata", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "Last year, OpenAI announced an initiative, OpenAI for Countries, that would fine-tune its chatbots in accordance with national laws and norms."}, {"diagnostic_version": "st