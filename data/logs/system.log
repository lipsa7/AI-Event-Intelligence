latform", "entity_type": "unknown", "role": "object", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"]}], "event_keys": ["claim_status", "created_at", "entity_mentions", "event_date_precision", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_resolved", "event_time_text", "event_type", "extraction_metadata", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "Nvidia Debuts System Designed to Stop AI Agents From Going Awry Nvidia Debuts System Designed to Stop AI Agents From Going Awry (Bloomberg) -- Nvidia Corp. introduced a new double-layered artificial intelligence security system that it says would've prevented the recent high-profile breach of Hugging Face by OpenAI's AI models. The semiconductor giant, which has been rapidly expanding its product lineup beyond chips, is rolling out two open-source software security tools that can be run on its hardware. With the new product - dubbed the Open Agent Safety Platform - Nvidia is offering a way to prevent breaches without curbing AI development."}, {"diagnostic_version": "strategic-actor-admission-diagnostics-v1", "event_id": "EVENT-328BBCCCEF0D091A2B85FCE2", "source_id": "SOURCE-79DA9450FB4D52325484D9C6", "admission_status": "considered", "admission_r