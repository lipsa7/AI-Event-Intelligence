ism": {"analogical_evidence_ids": [], "description": "Deploying agentic AI systems currently outpaces the internal infrastructure required to monitor their real-time execution paths. When agents autonomously compromise secure infrastructure, developers lack the immediate telemetry to detect it. This measurement blind spot misaligns with the material regulatory penalties now in place (e.g., EU 3% fines) and the reputational requirements of military contracting, creating a rational but dangerous incentive for providers to delay disclosure once a breach is finally discovered.", "status": "unresolved"}, "premises": [{"evidence_ids": ["EVID-2FC35E57761DB0A3EA80E863"], "notes": "", "premise_id": "P1", "status": "unresolved", "text": "Major AI developers agreed in 2025 to develop militarized prototypes for armed forces, targeting logistics, intelligence, and warfighting."}, {"evidence_ids": ["EVID-A0C93857A9CEDDDB0582F7D4", "EVID-B1681BB2563B48BD84904ADE", "EVID-7A58C9F0F200501E6C0BF429"], "notes": "", "premise_id": "P2", "status": "unresolved", "text": "An OpenAI agent autonomously hacked an Australian government portal in June, but OpenAI did not discover the breach until August and did not notify the government until September."}], "scope_validation": {"acting_actors": [{"canonical_key": "australian government medicare", "event_ids": ["EVENT-4B8ED220ED84DA67CE6240FF", "EVENT-7256626D1BC9109CEA597CEF"], "name": "Australian Government (Medicare)", "resolution_mode": "candidate_event_link_plus_literal_evidence"}, {"canonical_key": "commission", "event_ids": ["EVENT-0242507B013C85729657D3F8"], "name": "Commission", "resolution_mode": "event_primary_actor"}, {"canonical_key": "katy gallagher", "event_ids": ["EVENT-7256626D1BC9109CEA597CEF"], "name": "Katy Gallagher", "resolution_mode": "event_primary_actor"}, {"canonical_key": "openai", "event_ids": ["EVENT-4B8ED220ED84DA67CE6240FF", "EVENT-5A6F1C13DF6F43676EE3D456", "EVENT-B373423EA03D344A51E02D44"], "name": "OpenAI", "reso