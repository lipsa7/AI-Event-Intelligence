te to the agent since the company's relaunch, rolled out a few days before today's funding announcement. Manus 2.0 features a new harness, a collection of software modules designed to customize the underlying LLMs' behavior. It also ships with a tool that consumers can use to generate clips and video games. A second new feature, Cloud Computer, hosts AI-generated games' backend code in a managed environment. The third addition to Manus, Cue, makes it possible to equip AI agents with resources such as an email account and a digital wallet.", "raw_actor_fields": {"acting_entity": null, "actor": null, "company": null, "institution": null, "organisation": null, "organization": null, "primary_actor": null, "regulator": null}, "raw_entity_mentions": [{"entity_type": "organization", "mention": "Manus", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "actor"}, {"entity_type": "unknown", "mention": "Manus 2.0", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "object"}], "resolved_primary_actor": "Manus", "source_id": "SOURCE-19E3A5693D7A3EDDB1D9C78C"}, {"admission_reasons": [], "admission_status": "considered", "diagnostic_version": "strategic-actor-admission-diagnostics-v1", "entity_mentions_state": "present", "event_id": "EVENT-6E685136436BB1E67F5070C1", "event_keys": ["claim_status", "created_at", "entity_mentions", "event_date_precision", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_resolved", "event_time_text", "event_type", "extraction_metadata", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class"