count", "updated_at"], "event_summary": "Trump renames AI 'super intelligence' at the UN Trump told the UN General Assembly on 22 September that US documents will now call AI \"super intelligence\". He paired the rename with a pledge to encourage the technology rather than rein it in, and rejected global control of it. Donald Trump used his address to the UN General Assembly in New York on Tuesday to give artificial intelligence a new name. From now on, he said, US government documents would call it 'super intelligence', because 'artificial' made the technology sound fake. Trump told delegates that US documents, \" and hopefully the world's \", would switch to what he called the \" much more accurate term \", according to accounts from Fox News and Futurism . Trump said the US would encourage the technology and \" not rein it in \", a line CNBC also pulled from the speech. He paired that with a rejection of international oversight. The US would not accept any global mechanism to control the technology, he said, according to Fox News and Ynet .", "raw_actor_fields": {"acting_entity": null, "actor": null, "company": null, "institution": null, "organisation": null, "organization": null, "primary_actor": "Donald Trump", "regulator": null}, "raw_entity_mentions": [{"entity_type": "person", "mention": "Trump", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "actor"}, {"entity_type": "unknown", "mention": "UN General Assembly", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "object"}], "resolved_primary_actor": "Donald Trump", "source_id": "SOURCE-2B7353670B018A3630DE0F0F"}, {"admission_reasons": [], "admission_status": "considered", "diagnostic_version": "strategic-actor-admission-diagnostics-v1", "entity_mentions_state": "present", "event_id": "EVENT-E0AE0F1BAEC6A9604B083A0F", "event_keys": ["actor_recovered_from", "claim_status", "created_at",