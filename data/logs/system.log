 \"extremely friendly.\""}, {"diagnostic_version": "strategic-actor-admission-diagnostics-v1", "event_id": "EVENT-7342AB2BEFB0DF6B3D041DCF", "source_id": "SOURCE-C17896B7BB016684E2B7610E", "admission_status": "considered", "admission_reasons": [], "resolved_primary_actor": "US government", "entity_mentions_state": "present", "raw_actor_fields": {"primary_actor": null, "acting_entity": null, "actor": null, "organization": null, "organisation": null, "company": null, "institution": null, "regulator": null}, "raw_entity_mentions": [{"mention": "President Donald Trump", "entity_type": "person", "role": "actor", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"]}, {"mention": "US government", "entity_type": "unknown", "role": "object", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"]}], "event_keys": ["claim_status", "created_at", "entity_mentions", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_text", "event_type", "extraction_metadata", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "Trump orders US government to call AI ‘Super Intelligence’ Trump orders US government to call AI 'Super Intelligence' Going forward, official policy websites, policy documents, and press releases will refer only to \"Super Intelligence,\" thanks to a new executive order signed by President Donald Trump. Trump signed the executive order after a luncheon he hosted at the White House with tech CEOs and government officials to discuss what he's now officially calling Super Intelligence."}, {"diagnostic_version": "strategic-actor-admission-diagnostics-v1", "event_id": "EVENT-82643B20BFED8A004C182528", "source_id": "SOURCE-C17896B7BB016684E2B7610E", "admission_status": "considered", "admission_reasons": [], "resolved_primary_actor": "Anthropic", "entity_mentions_state": "present", "raw_actor_fields": {"primary_actor": null, "acting_entity": null, "actor": null, "organization": null, "organisation": null, "company": null, "institution": null, "regulator": null}, "raw_entity_mentions": [{"mention": "Anthropic", "entity_type": "organization", "role": "actor", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"]}, {"mention": "'abusive or cruel behavior' toward Claude", "entity_type": "unknown", "role": "object", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"]}], "event_keys": ["claim_status", "created_at", "entity_mentions", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_text", "event_type", "extraction_metadata", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "sum