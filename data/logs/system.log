o Alto Networks CEO Nikesh Arora and Altimeter Capital CEO Brad Gerstner. The technology leaders joined Vice President JD Vance, House Speaker Mike Johnson, Treasury Secretary Scott Bessent, Commerce Secretary Howard Lutnick and White House Chief of Staff Susie Wiles."}, {"diagnostic_version": "strategic-actor-admission-diagnostics-v1", "event_id": "EVENT-D52422919309DC6A9B2ED92D", "source_id": "SOURCE-EB578AFA52D107B33EFE3B0A", "admission_status": "considered", "admission_reasons": [], "resolved_primary_actor": "Donald Trump", "entity_mentions_state": "present", "raw_actor_fields": {"primary_actor": "Donald Trump", "acting_entity": null, "actor": null, "organization": null, "organisation": null, "company": null, "institution": null, "regulator": null}, "raw_entity_mentions": [{"mention": "Trump", "entity_type": "person", "role": "actor", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"]}, {"mention": "voluntary framework", "entity_type": "unknown", "role": "object", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"]}], "event_keys": ["actor_recovered_from", "claim_status", "created_at", "entity_mentions", "event_date_precision", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_resolved", "event_time_text", "event_type", "extraction_metadata", "primary_actor", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relev