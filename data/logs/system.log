 "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "Juspay FY26 revenue rises 30% to Rs 664 Cr as international business and AI bets scale Juspay FY26 revenue rises 30% to Rs 664 Cr as international business and AI bets scale Juspay reported a 30% year-on-year increase in FY26 revenue to Rs 664 crore, driven by global expansion and scaling daily transaction volumes, while strategic investments in AI infrastructure widened its net loss. Global payments technology company Juspay reported a 30% year-on-year increase in revenue for the financial year ended March 31, 2026 (FY26), reaching Rs 664 crore, up from Rs 514 crore in FY25. The Bengaluru-headquartered fintech firm remained Adjusted EBITDA positive at Rs 33 crore for FY26, excluding non-cash ESOP costs. However, increased capital allocation towards global market expansion and deep-tech artificial intelligence infrastructure widened its net loss to Rs 90 crore for the fiscal year.", "raw_actor_fields": {"acting_entity": null, "actor": null, "company": null, "institution": null, "organisation": null, "organization": null, "primary_actor": null, "regulator": null}, "raw_entity_mentions": [{"entity_type": "organization", "mention": "Juspay", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "actor"}], "resolved_primary_actor": "Juspay", "source_id": "SOURCE-62E4F84D0677B1E6F242A961"}, {"admission_reasons": [], "admission_status": "considered", "diagnostic_version": "strategic-actor-admission-diagnostics-v1