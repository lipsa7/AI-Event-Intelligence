mber_count", "updated_at"], "event_summary": "Albanese made the breach public following a telephone conversation with OpenAI chief executive Sam Altman. \"Today I spoke with ... Altman to express Australia's extreme concern about this incident,\" Albanese told reporters. \"I also expressed my disappointment that it took the company way too long to inform the government what had occurred and the nature of the way that notification occurred as well was unacceptable.\"", "raw_actor_fields": {"acting_entity": null, "actor": null, "company": null, "institution": null, "organisation": null, "organization": null, "primary_actor": "Anthony Albanese", "regulator": null}, "raw_entity_mentions": [{"entity_type": "person", "mention": "Anthony Albanese", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "actor"}, {"entity_type": "unknown", "mention": "Sam Altman", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "object"}], "resolved_primary_actor": "Anthony Albanese", "source_id": "SOURCE-58036158F50E552381CC7C82"}, {"admission_reasons": [], "admission_status": "considered", "diagnostic_version": "strategic-actor-admission-diagnostics-v1", "entity_mentions_state": "present", "event_id": "EVENT-F26FB7427E1B51498FC521A7", "event_keys": ["claim_status", "created_at", "entity_mentions", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_text", "event_type", "extraction_metadata", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strat