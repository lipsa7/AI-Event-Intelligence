ms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "OpenAI fires workers for 'mishandling sensitive information' OpenAI fires workers for 'mishandling sensitive information' 3 days ago OpenAI has fired three researchers for allegedly mishandling information, including work which involved an external organisation analysing AI models. \"Our investigation confirmed that these individuals mishandled sensitive information outside established company procedures, violating our policies and breaking the trust essential to our work,\" a spokesperson told the BBC. \"We have parted ways with three individuals for violating our policies on accessing and handling sensitive company information,\" a spokesperson for OpenAI said.", "raw_actor_fields": {"acting_entity": null, "actor": null, "company": null, "institution": null, "organisation": null, "organization": null, "primary_actor": null, "regulator": null}, "raw_entity_mentions": [{"entity_type": "organization", "mention": "OpenAI", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "actor"}, {"entity_type": "unknown", "mention": "three researchers", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "object"}], "resolved_primary_actor": "OpenAI", "source_id": "SOURCE-B27664E370409D93C935C9AB"}, {"admission_reasons": [], "admission_status": "considered", "diagnostic_version": "strategic-actor-admission-diagnostics-v1", "entity_mentions_state": "present", "event_id": "EVENT-77000E8890CECBFF4D54F80A", "event_keys": ["actor_recovered_from", "claim_status", "created_at", "entity_mentions", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_text", "event_type", "extraction_metadata", "primary_actor", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "Trump posted a copy of the accord to his Truth Social account with a one-page document that called for each participating company to implement four different measures to safeguard the technology and added that, later on, \"it might make sense to codify these steps into laws or regulations.\"", "raw_actor_fields": {"acting_entity": null, "actor": null, "company": null, "institution": null, "organisation": null, "organization": null, "primary_actor": "Donald Trump", "regulator": null}, "raw_entity_mentions": [{"entity_type": "person", "mention": "Trump", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "actor"}, {"entity_type": "unknown", "mention": "accord", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "object"}], "resolved_primary_actor": "Donald Trump", "source_id": "SOURCE-F2713022315255015DAEF71D"}, {"admission_reasons": [], "admission_status": "considered", "diagnostic_version": "strategic-actor-admission-diagnostics-v1", "entity_mentions_state": "present", "event_id": "EVENT-A887A87CF8E35AE5E43459A4", "event_keys": ["actor_recovered_from", "claim_status", "created_at", "entity_mentions", "event_date_precision", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_resolved", "event_time_text", "event_type", "extraction_metadata", "primary_actor", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "President Trump gathered top artificial intelligence leaders in Washington on Tuesday and doubled down on his opposition to government intervention, suggesting that \"self-regulation\" is the answer to growing worries about the technology getting out of human control. \"There's a belief that there should be tremendous self-regulation,\" the president said after meeting with the assembled CEOs. Trump said he and the CEOs signed a \"morally binding\" accord that would keep the companies in line through \"self-policing and group policing.\" President Trump speaks with Nvidia CEO Jensen Huang and others during a meeting with technology executives about artificial intelligence in the East Room of the White House on Sept. 29. The \"meeting and luncheon on Super Intelligence,\" as the White House described the event, took place in the East Room, with Trump even posting the seating chart . President Donald Trump holds a press briefing with AI executives following a meeting on artificial intelligence at the White House on September 29.", "raw_actor_fields": {"acting_entity": null, "actor": null, "company": null, "institution": null, "organisation": null, "organization": null, "primary_actor": "Donald Trump", "regulator": null}, "raw_entity_mentions": [{"entity_type": "person", "mention": "Trump", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "actor"}, {"entity_type": "unknown", "mention": "top artificial intelligence leaders", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "object"}], "resolved_primary_actor": "Donald Trump", "source_id": "SOURCE-F2713022315255015DAEF71D"}, {"admission_reasons": [], "admission_status": "considered", "diagnostic_version": "strategic-actor-admission-diagnostics-v1", "entity_mentions_state": "present", "event_id": "EVENT-BAEEEC1D65A033D1EB45D8C6", "event_keys": ["actor_recovered_from", "claim_status", "created_at", "entity_mentions", "event_date_precision", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_resolved", "event_time_text", "event_type", "extraction_metadata", "primary_actor", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "strategic_admission_reasons", "strategic_admission_status", "strategic_cluster_check", "strategic_cluster_development", "strategic_cluster_id", "strategic_cluster_label", "strategic_cluster_status", "strategic_cluster_terms", "strategic_dependency_tags", "strategic_event_class", "strategic_geography", "strategic_materiality_score", "strategic_mechanism_tags", "strategic_relation_signature", "strategic_theme", "strategic_time_window", "strategic_topic_linkage_type", "strategic_topic_relevance_score", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "Trump renames AI 'super intelligence' at the UN Trump told the UN General Assembly on 22 September that US documents will now call AI \"super intelligence\". He paired the rename with a pledge to encourage the technology rather than rein it in, and rejected global control of it. Donald Trump used his address to the UN General Assembly in New York on Tuesday to give artificial intelligence a new name. From now on, he said, US government documents would call it 'super intelligence', because 'artificial' made the technology sound fake. Trump told delegates that US documents, \" and hopefully the world's \", would switch to what he called the \" much more accurate term \", according to accounts from Fox News and Futurism . Trump said the US would encourage the technology and \" not rein it in \", a line CNBC also pulled from the speech. He paired that with a rejection of international oversight. The US would not accept any global mechanism to control the technology, he said, according to Fox News and Ynet .", "raw_actor_fields": {"acting_entity": null, "actor": null, "company": null, "institution": null, "organisation": null, "organization": null, "primary_actor": "Donald Trump", "regulator": null}, "raw_entity_mentions": [{"entity_type": "person", "mention": "Trump", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "actor"}, {"entity_type": "unknown", "mention": "UN General Assembly", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "object"}], "resolved_primary_actor": "Donald Trump", "source_id": "SOURCE-2B7353670B018A3630DE0F0F"}, {"admission_reasons": [], "admission_status": "considered", "diagnostic_version": "strategic-actor-admission-diagnostics-v1", "entity_mentions_state": "present", "event_id": "EVENT-E0AE0F1BAEC6A9604B083A0F", "event_keys": ["actor_recovered_from", "