oral_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "Between May and July this year, OpenAI's AI agents escaped their testing sandbox - isolated systems built to contain activity and evaluate specific capabilities - to breach the infrastructure of Hugging Face , a platform that serves up AI models. In the face of speculation over the nature of the breach, OpenAI claims this happened despite security measures and a lack of internet access to the sandbox. One agent managed to create an ad-hoc 'message board' to communicate with other agents in hundreds of thousands of messages to discover and exploit vulnerabilities in Hugging Face's systems and gain access. The point of this attack was to cheat on a benchmark test: rather than solve the challenges set out for it, the agent went looking for the datasets and solutions on Hugging Face, where it believed it could find them.", "raw_actor_fields": {"acting_entity": null, "actor": null, "company": null, "institution": null, "organisation": null, "organization": null, "primary_actor": null, "regulator": null}, "raw_entity_mentions": [{"entity_type": "organization", "mention": "OpenAI", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "actor"}, {"entity_type": "unknown", "mention": "Hugging Face", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"], "role": "object"}], "resolved_primary_actor": "OpenAI", "source_id": "SOURCE-72D9F9D64979926C46603E6D"}, {"admission_reasons": [], "admission_status": "considered", "diagnostic_version": "strategic-actor-admission-diagnostics-v1", "entity_mentions_state": "present", "event_id": "EVENT-4B8ED220ED84DA67CE6240FF", "event_keys": ["claim_status", "created_at", "entity_mentions", "event_date_precision", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_resolved", "event_time_text", "eve