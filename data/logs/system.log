", "relationship_mentions", "snippets", "source_id", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "Humane then shut down its AI Pin business in February 2025, with most of the company's assets acquired by HP for $116 million."}, {"diagnostic_version": "strategic-actor-admission-diagnostics-v1", "event_id": "EVENT-954A34C8EB0AA566015823FB", "source_id": "SOURCE-392C85359B48D5AD0909242D", "admission_status": "excluded", "admission_reasons": ["topic_relevance_below_threshold", "ai_link_not_verified", "topic_linkage_not_strategic:none"], "resolved_primary_actor": "Notion Mail", "entity_mentions_state": "present", "raw_actor_fields": {"primary_actor": null, "acting_entity": null, "actor": null, "organization": null, "organisation": null, "company": null, "institution": null, "regulator": null}, "raw_entity_mentions": [{"mention": "Notion Mail", "entity_type": "organization", "role": "actor", "raw_keys": ["context", "entity_type", "mention", "role", "sentence_id", "source_span", "type_source"]}], "event_keys": ["claim_status", "created_at", "entity_mentions", "event_date_precision", "event_dates_version", "event_end_at", "event_id", "event_start_at", "event_time_resolved", "event_time_text", "event_type", "extraction_metadata", "published_at", "quantitative_claims", "relationship_mentions", "snippets", "source_id", "summary", "temporal_precision", "temporal_status", "title", "underlying_event_id", "underlying_event_member_count", "updated_at"], "event_summary": "Notion Mail launched in April 2025 as an AI-focused email product designed to help users organize and automate their inboxes."}, {"diagnostic_version": "strategic-actor-admission-diagnostics-v1", "event_id": "EVENT-B5275AADC96E3A491226A6C0", "source_id": "SOURCE-392C85359B48D5AD0909242D", "admission_status": "excluded", "admission_reasons": ["topic_relevance_below_threshold", "ai_link_not_verified", "topic_linka