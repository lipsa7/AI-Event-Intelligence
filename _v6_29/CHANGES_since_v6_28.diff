+    actor["rejected"] = [{"move": _clean(r.get("move"))[:300], "why_not": _clean(r.get("why_not"))[:300]}
+                         for r in data.get("rejected") or [] if isinstance(r, Mapping) and _clean(r.get("move"))][:4]
+    return True
+
